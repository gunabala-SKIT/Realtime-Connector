# Reality Connector - Phase 1 camera configuration
# Copy this file to ".env" and fill in real values.  NEVER commit .env.
#
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (bash)

# ---------------------------------------------------------------------------
# Hikvision DVR/NVR RTSP settings
# ---------------------------------------------------------------------------
CAMERA_IP=192.168.1.64
RTSP_PORT=554
CAMERA_USER=admin
CAMERA_PASSWORD=changeme

# Channel / stream id.  Hikvision convention (CONFIRM on your DVR):
#   101 = channel 1 main stream      102 = channel 1 sub stream
#   201 = channel 2 main stream      202 = channel 2 sub stream ...
# Start with a SUB stream (e.g. 102) for the first connectivity test - it is lighter.
CAMERA_CHANNEL=102

# Path template - {channel} is substituted. Confirm against your DVR/NVR model.
CAMERA_RTSP_PATH=/Streaming/Channels/{channel}

# Optional: full RTSP URL override for non-standard DVRs. If set, IP/PORT/CHANNEL/PATH
# above are ignored for URL building (credentials are still injected if the URL has none).
# RTSP_URL=

# Optional: use a local webcam index or a video file instead of RTSP, so the pipeline
# can be verified before the DVR is reachable. Leave blank to use RTSP.
# CAMERA_SOURCE=0
# CAMERA_SOURCE=D:\samples\doorway.mp4

# ---------------------------------------------------------------------------
# Connection / reconnect policy
# ---------------------------------------------------------------------------
RTSP_TRANSPORT=tcp             # tcp (recommended, reliable) or udp (lower latency, lossy)
OPEN_TIMEOUT_MS=8000           # max wait when opening / reading the stream
READ_RETRY_LIMIT=5            # consecutive failed reads before the stream is declared down
RECONNECT_WAIT_SECONDS=3      # wait between reconnect attempts (doc: 2-5 s)
RECONNECT_MAX_ATTEMPTS=0      # steady-state: 0 = retry forever after a mid-run drop
STARTUP_MAX_ATTEMPTS=3       # initial connect: give up after N tries so the app never hangs
TARGET_FPS=0                  # 0 = display frames as fast as they arrive; else throttle

# CAPTURE_BUFFER=1           # frames OpenCV keeps queued. Unset = smoother on a lossy
#                            #  stream; 1 = lowest latency (can worsen decode if frames drop)
# FFMPEG_LOGLEVEL=fatal      # quiet the libav "decode_slice_header error" spam:
#                            #  quiet | fatal | error | warning | info  (default: libav's own)

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_DIR=logs

# ---------------------------------------------------------------------------
# Phase 2 - person detection + tracking (only read by phase2_detect)
# ---------------------------------------------------------------------------
# GTX 1660 @ 960px:  yolo11n ~55fps  |  yolo11s ~26fps  |  yolo11m ~15fps
YOLO_MODEL=yolo11s.pt        # yolo11n (fastest) | yolo11s | yolo11m (best recall) ...
YOLO_DEVICE=                 # blank = auto (CUDA if available) | cpu | 0
YOLO_CONF=0.25               # min detection confidence (lower = catches small/partial people)
YOLO_IOU=0.6                 # NMS IoU (higher = keep overlapping people in crowds)
YOLO_IMGSZ=960               # inference size (640 fast, 1280 for small/distant people)
YOLO_CLASSES=0               # COCO classes to keep; 0 = person
TRACKER=botsort.yaml         # botsort.yaml | bytetrack.yaml
PROCESS_EVERY_N=1            # run AI on every Nth frame (raise if AI fps < stream fps)
YOLO_HALF=false              # FP16 - leave off on GTX 16-series

# ---------------------------------------------------------------------------
# Phase 3 - face detection + recognition + identity (only read by phase3_identity)
# ---------------------------------------------------------------------------
FACE_MODEL_PACK=buffalo_l    # buffalo_l (best) | buffalo_s (lighter)
FACE_DET_SIZE=640
FACE_DEVICE=                 # blank = CUDA if available | cpu
FACE_MIN_IOD=40             # live gate: inter-ocular distance, px
ENROLL_MIN_IOD=45         # enrolment gate: stricter - enrol from close-up headshots
FACE_MAX_YAW=30            # quality gate: head yaw, degrees
FACE_BLUR_MIN=55           # quality gate: variance of Laplacian
FACE_DET_SCORE_MIN=0.55
RECOGNITION_THRESHOLD=0.35  # cosine similarity operating point (fixed & documented)
RECOGNIZE_EVERY_N=5        # per-track recognition cadence once identity is settled
IDENTITY_CONFIRM_FRAMES=3  # multi-frame confirmation before RECOGNIZED / UNKNOWN
IDENTITY_FLIP_COOLDOWN_S=2 # min seconds between RECOGNIZED<->UNKNOWN flips
# GALLERY_DB=phase3_identity/gallery.db
