# Copy to .env in this same folder (garment_cv/configs/.env) and fill in your camera.
# Nothing here is required to have a real camera yet - see the "try it without a camera" note
# in garment_cv/README.md.

# --- Camera (Phase 1) ---------------------------------------------------------------
# One of:
#   a webcam index, e.g.            GARMENT_CAMERA_SOURCE=0
#   an RTSP/HTTP URL, e.g.          GARMENT_CAMERA_SOURCE=rtsp://192.168.1.50:554/Streaming/Channels/101
#   a local video file, for testing GARMENT_CAMERA_SOURCE=D:/path/to/sample.mp4
GARMENT_CAMERA_SOURCE=

# Optional: if the URL above has no user:pass@ in it, these are merged in (kept out of logs).
GARMENT_CAMERA_USER=
GARMENT_CAMERA_PASSWORD=

GARMENT_CAMERA_ID=camera-1
GARMENT_CAMERA_NAME=Camera 1

# rtsp_transport for network cameras: tcp (default, more reliable) or udp (lower latency)
GARMENT_RTSP_TRANSPORT=tcp
GARMENT_OPEN_TIMEOUT_MS=8000
GARMENT_READ_RETRY_LIMIT=5
GARMENT_RECONNECT_WAIT_SECONDS=3
GARMENT_RECONNECT_MAX_ATTEMPTS=0
GARMENT_STARTUP_MAX_ATTEMPTS=3
# GARMENT_CAPTURE_BUFFER=1
# GARMENT_FFMPEG_LOGLEVEL=warning

GARMENT_STREAM_MAX_WIDTH=960
GARMENT_JPEG_QUALITY=80

# --- Object detection (Phase 2) - a COCO-pretrained model, stand-in for a real garment model --
# See garment_cv/backend/detection/coco_standin.py: only person/scissors/table have a real match.
GARMENT_DETECT_ENABLED=true
GARMENT_DETECT_MODEL=yolo11n.pt
GARMENT_DETECT_DEVICE=
GARMENT_DETECT_CONF=0.35
GARMENT_DETECT_IOU=0.5
# Per-class confidence overrides, name=value. Scissors in use are small and half hidden by fingers: the
# trained model finds them at 0.1-0.5 confidence, and the global bar above threw most of those away,
# so the activity engine saw them flicker. Zero false scissors on scissors-free clips even at 0.01.
GARMENT_DETECT_CLASS_CONF=scissors=0.10
GARMENT_DETECT_IMGSZ=640
# Keep false on GTX 16-series GPUs (no tensor cores - FP16 produces NaNs there).
GARMENT_DETECT_HALF=false
GARMENT_DETECT_INTERVAL_S=0.3
GARMENT_DETECT_STREAM_MAX_WIDTH=960
GARMENT_DETECT_JPEG_QUALITY=80

# --- Object tracking (Phase 3) - gives each detected object a stable ID across frames ---------
GARMENT_TRACK_ENABLED=true
# bytetrack.yaml (lighter) or botsort.yaml (adds camera-motion compensation + re-identification)
GARMENT_TRACKER=botsort.yaml

# --- Zones (Phase 4) - where drawn zones are saved (no database exists yet) -------------------
# GARMENT_ZONES_FILE=configs/zones.json

# --- Activity detection (Phase 5) - object + zone + movement + duration, never a single frame's
# object presence alone (spec section 3: "worker holding scissors ≠ cutting"). Only CUTTING can
# actually fire with the COCO stand-in - see garment_cv/backend/activities/rules.py.
GARMENT_ACTIVITY_ENABLED=true
GARMENT_ACTIVITY_CUTTING_MIN_S=3.0
GARMENT_ACTIVITY_MARKING_MIN_S=3.0
GARMENT_ACTIVITY_STITCHING_MIN_S=5.0
GARMENT_ACTIVITY_PIECE_HANDLING_MIN_S=2.0
GARMENT_ACTIVITY_IDLE_MIN_S=10.0
# How long a rule's condition may drop out (an occlusion, a hand briefly blocking the view)
# without restarting its confirmation timer from zero.
GARMENT_ACTIVITY_GRACE_S=1.5
GARMENT_ACTIVITY_MOVEMENT_WINDOW_S=2.0
# Motion = how far the object's centre and box size spread within the window (a pair of scissors
# snips in place, so its position barely moves but its box changes size), as a fraction of the frame
# diagonal. Measured on real clips: scissors lying still 0.0004-0.0020, real cutting 0.0039-0.0195.
GARMENT_ACTIVITY_MOVEMENT_MIN_FRACTION=0.0028
GARMENT_ACTIVITY_ATTRIBUTION_MARGIN=0.3
GARMENT_ACTIVITY_MAX_HISTORY=200
# How close (fraction of the frame diagonal) scissors must be to cloth to count as cutting it.
# Only applies when the loaded model can see cloth; the COCO stand-in can't, so it's skipped there.
GARMENT_ACTIVITY_CONTACT_MARGIN=0.008
# Spec section 3's "Fabric detected" condition for CUTTING. Set to false if the model can't see your
# cloth in practice (e.g. a small scrap held in the hand, hidden by fingers) - then moving scissors in
# a cutting zone counts, including waving them around without cutting.
GARMENT_ACTIVITY_REQUIRE_CLOTH=true

# --- Database (Phase 6) - where completed activities are persisted as production events --------
# SQLite, not the spec's "recommended" PostgreSQL - a single-camera MVP has no concurrent-writer
# problem a file database can't handle. See garment_cv/backend/database/db.py's module docstring.
# GARMENT_DB_FILE=configs/garment.db

# --- Bottleneck baselines (Phase 7, spec section 18) - an expected duration per stage, compared
# against the measured average. Leave unset to skip that stage's row entirely - the system never
# guesses a baseline, and never guesses *why* a stage is slow either.
# GARMENT_BASELINE_MARKING_S=480
# GARMENT_BASELINE_CUTTING_S=300
# GARMENT_BASELINE_STITCHING_S=720
# GARMENT_BASELINE_PIECE_HANDLING_S=150

# --- Server --------------------------------------------------------------------------
GARMENT_HOST=127.0.0.1
GARMENT_PORT=8200
GARMENT_LOG_LEVEL=INFO
# GARMENT_LOG_DIR=logs

# --- Odoo Manufacturing bridge (Odoo 19) ----------------------------------------------------------
# The camera starts/finishes work orders in Odoo: Marking detected -> "Marking" starts; cutting
# confirmed -> Marking done + "Cutting" starts; cutting finished (enough cutting, then a quiet period)
# -> Cutting done + the MO is marked done. See garment_cv/docs/ODOO_RUNBOOK.md.
#
#   off     does nothing (default)
#   shadow  decides and records what it WOULD do, never writes to Odoo - run this first
#   live    updates Odoo
# The mode can also be switched at runtime from the dashboard's Odoo tab (the kill switch); the
# runtime choice is remembered across restarts and wins over this value.
GARMENT_ODOO_MODE=off
# GARMENT_ODOO_URL=http://localhost:8069
# GARMENT_ODOO_DB=your_database
# An Odoo API key (My Profile > Account Security > New API Key) of a dedicated integration user.
# GARMENT_ODOO_API_KEY=
# The Odoo Work Center whose "Code" field equals this value is "this camera". Defaults to GARMENT_CAMERA_ID.
# GARMENT_ODOO_WORKCENTER=camera-1
# Odoo operation name (case-insensitive) = camera activity. An MO with an operation at this work
# center that is not listed here is flagged, never guessed at.
# GARMENT_ODOO_OPERATION_MAP=Marking=MARKING,Cutting=CUTTING
#
# Finish rules (seconds). Nothing finishes on a single event: picking up or putting down scissors
# never confirms CUTTING, and pauses shorter than QUIET_S never finish the last operation.
# GARMENT_ODOO_START_HOLD_S=2        activity must stay confirmed this long to start an operation
# GARMENT_ODOO_HANDOFF_HOLD_S=3      next operation's activity must stay confirmed this long to hand off
# GARMENT_ODOO_MIN_ACTIVE_S=10       last operation: minimum total activity before it may finish
# GARMENT_ODOO_QUIET_S=15            last operation: not cutting (idle, or away from the zone) for this long -> finish
# GARMENT_ODOO_POLL_S=3              how often to sync with Odoo and send queued actions
# GARMENT_ODOO_ARM_ON_CONFIRMED=false  also act on an MO that is confirmed but not yet "Start"-ed
# GARMENT_ODOO_POST_NOTES=true       leave an audit note on the MO's chatter for each action
